<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main>
    <h1>Modificar producto</h1>

    <form id="buscarProductoForm">
        <label for="idProducto">ID del producto:</label>
        <input id="idProducto" name="id" type="number" min="1" required>
        <button type="submit">Buscar producto</button>
    </form>

    <p id="mensaje" role="status"></p>

    <form id="formularioModificar" hidden>
        <input id="idModificar" name="id" type="hidden">

        <label for="nombreModificar">Nombre:</label>
        <input id="nombreModificar" name="nombre" type="text" required>

        <label for="precioModificar">Precio:</label>
        <input id="precioModificar" name="precio" type="number" min="1" step="1" required>

        <label for="categoriaModificar">Categoría:</label>
        <input id="categoriaModificar" name="categoria" type="text" required>

        <label for="imagenModificar">URL de la imagen:</label>
        <input id="imagenModificar" name="imagen" type="url" required>

        <label for="estadoModificar">Estado:</label>
        <select id="estadoModificar" name="estado" required>
            <option value="1">Activo</option>
            <option value="0">Inactivo</option>
        </select>

        <button type="submit">Guardar cambios</button>
    </form>
</main>

<script src="/js/put.js" defer></script>
<%- include("partials/footer.ejs") %>
