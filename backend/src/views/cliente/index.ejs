<%- include("../partials/head.ejs") %>

<header id="inicio">
    <div class="encabezado">
        <div class="buscador" role="search">
            <input
                type="search"
                aria-label="Buscar productos"
                placeholder="Buscar productos"
            >
        </div>

        <img
            class="logo"
            src="/assets/img/Logotipo minimalista de essence.png"
            alt="Essence"
        >

        <div class="encabezado-imagenes">
            <a href="#" aria-label="Cuenta">
                <img
                    src="/assets/img/web/cuenta.svg"
                    alt="Cuenta"
                >
            </a>

            <a href="#" aria-label="Bolsa">
                <img
                    src="/assets/img/web/bolsa.svg"
                    alt="Bolsa"
                >
            </a>
        </div>
    </div>
</header>

<main class="pagina-cliente">
    <h1>Productos</h1>

    <section id="productos">
        <div class="catalogo">
            <% if (listaProductos.length === 0) { %>
                <p>No hay productos para mostrar.</p>
            <% } %>

            <% listaProductos.forEach((producto) => { %>
                <article class="producto">
                    <% if (producto.imagen) { %>
                        <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
                    <% } else { %>
                        <div class="producto-sin-imagen">Sin imagen</div>
                    <% } %>

                    <h2><%= producto.nombre %></h2>
                    <p class="precio"><%= Number(producto.precio).toLocaleString("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 }) %></p>
                </article>
            <% }); %>
        </div>
    </section>
</main>

<%- include("../partials/footer.ejs") %>
