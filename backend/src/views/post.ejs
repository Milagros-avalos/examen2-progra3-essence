<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main>
    <h1>Crear producto</h1>
    <form id="crearProductoForm">
        <label for="nombre">Nombre:</label>
        <input id="nombre" name="nombre" type="text" required>

        <label for="precio">Precio:</label>
        <input id="precio" name="precio" type="number" min="1" step="1" required>

        <label for="categoria">Categoría:</label>
        <input id="categoria" name="categoria" type="text" value="Perfumes" required>

        <label for="imagen">URL de la imagen:</label>
        <input id="imagen" name="imagen" type="url" required>

        <button type="submit">Guardar producto</button>
    </form>
    <p id="mensaje" role="status"></p>
</main>

<script src="/js/post.js" defer></script>
<%- include("partials/footer.ejs") %>
